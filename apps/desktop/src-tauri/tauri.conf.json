{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocab Collector",
  "version": "0.1.0",
  "identifier": "app.vocabcollector.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../../ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../../../ui build",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vocab Collector",
        "width": 1040,
        "height": 720,
        "minWidth": 840,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

